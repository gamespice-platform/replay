# Godot 4
.godot/
/android/

# gs-core is a separate repository. For local development, symlink it:
#   ln -s ../../gs-core/addons/gs_core addons/gs_core
# Consumers copy both addons into their own project.
/addons/gs_core
/addons/gs_profile

# Exports
build/
export_presets.cfg

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/

# Only examples/net_selftest needs gs-net (the one check that runs the net tap against it):
#   ln -s ../../gs-net/addons/gs_net addons/gs_net
/addons/gs_net

# Sibling addons linked for local suites (absolute links must never be tracked; CI resolves them from addons.lock):
/addons/gs_save
